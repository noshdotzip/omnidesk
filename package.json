{
  "name": "ultidesk",
  "private": true,
  "version": "0.0.1",
  "description": "Ultidesk — a distributed desktop compositor that makes multiple computers feel like one workstation. LAN-only, window-projection based.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "node scripts/check-native-arch.mjs",
    "doctor:arch": "node scripts/check-native-arch.mjs",
    "proto:gen": "pnpm --filter @ultidesk/protocol-ts run generate",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "desktop:dev": "pnpm --filter @ultidesk/desktop run dev",
    "agent:build": "cargo build -p ultidesk-agent",
    "agent:check": "cargo clippy --workspace --all-targets -- -D warnings",
    "agent:test": "cargo test --workspace"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
